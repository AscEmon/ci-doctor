# Copy to .env and fill in real values. Never commit .env.
GITHUB_TOKEN=[PLACEHOLDER]
# Only needed for analyze/eval.
GEMINI_API_KEY=[PLACEHOLDER]

# Optional overrides
# GITHUB_API_URL=https://api.github.com
# DATA_DIR=data

# Analyzer
# CIDOC_MODEL=gemini-3.5-flash-lite
# CIDOC_RPM=10
# CIDOC_TOKEN_BUDGET=6000
# USD per million tokens, per model, as JSON. Copy the current prices from the provider's
# pricing page; without them cost shows as unknown and --max-cost cannot be used.
# CIDOC_PRICES={"gemini-3.5-flash-lite": {"input": [PLACEHOLDER], "output": [PLACEHOLDER]}}
